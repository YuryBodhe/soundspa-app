# Copy to ignored .env.v2; choose a new V2-only password, never V1 credentials.
V2_POSTGRES_PASSWORD=REPLACE_WITH_A_NEW_V2_SECRET
# URL-encode password characters where necessary.
V2_DATABASE_URL=postgresql://soundspa_v2:REPLACE_WITH_A_NEW_V2_SECRET@v2-postgres:5432/soundspa_v2
# Required for the isolated Content Admin. No defaults; configure only at runtime.
V2_ADMIN_USERNAME=
V2_ADMIN_PASSWORD=
# Local-only verification/dev: choose a dedicated existing external media root.
# Staging Compose sets the canonical server path explicitly.
V2_MEDIA_ROOT=

# Canonical storage backend. Only local is implemented; omitted also means local.
V2_MEDIA_STORAGE_BACKEND=local
